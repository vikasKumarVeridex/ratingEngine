    "formulas": [
      {
        "name": "Vikram & Sons — Auto Liability",
        "cob": "Auto Liability",
        "scope": "Class of Business",
        "status": "Active",
        "effectiveFrom": "2026-09-01",
        "_note": "Mirrors the engine's own filed Auto Liability chain: Base LC x (ILF - Deductible) x LCM, then RemainingFactors, which multiplies in every other factor the engine supplies for this coverage AND every imported factor once approved. A new tenant has no formula of its own, so without this the imported factors can never reach a premium.",
        "tokens": [
          {
            "t": "var",
            "v": "BasePremium"
          },
          {
            "t": "op",
            "v": "×"
          },
          {
            "t": "var",
            "v": "RemainingFactors"
          }
        ],
        "expression": "BasePremium × RemainingFactors"
      },
      {
        "name": "Vikram & Sons — Physical Damage",
        "cob": "Physical Damage",
        "scope": "Class of Business",
        "status": "Active",
        "effectiveFrom": "2026-09-01",
        "_note": "VehicleValue is pinned to 1 by the engine so this evaluates a per-$-of-value rate, not a dollar amount — the engine applies the vehicle value and its floor-rate safety net afterwards.",
        "tokens": [
          {
            "t": "var",
            "v": "BasePremium"
          },
          {
            "t": "op",
            "v": "×"
          },
          {
            "t": "var",
            "v": "RemainingFactors"
          }
        ],
        "expression": "BasePremium × RemainingFactors"
      }
    ],
